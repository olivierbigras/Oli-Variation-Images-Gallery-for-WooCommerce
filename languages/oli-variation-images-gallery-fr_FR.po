msgid "%d variation imported. Original data was not modified."
msgid_plural "%d variations imported. Original data was not modified."
msgstr[0] "%d variation importée. Les données d'origine n'ont pas été modifiées."
msgstr[1] "%d variations importées. Les données d'origine n'ont pas été modifiées."


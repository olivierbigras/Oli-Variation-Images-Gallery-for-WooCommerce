#: oli-variation-images-gallery.php
msgid "Oli Variation Images Gallery requires WooCommerce to be installed and active."
msgstr "Oli Variation Images Gallery nécessite que WooCommerce soit installé et actif."

#: oli-variation-images-gallery.php
msgid "This plugin requires WooCommerce to be installed and active."
msgstr "Cette extension nécessite que WooCommerce soit installé et actif."

#: includes/class-oli-vig-admin.php
msgid "Add Images to Variation Gallery"
msgstr "Ajouter des images à la galerie de variation"

#: includes/class-oli-vig-admin.php
msgid "Add to gallery"
msgstr "Ajouter à la galerie"

#: includes/class-oli-vig-admin.php
msgid "Remove image %s"
msgstr "Retirer l'image %s"

#: includes/class-oli-vig-admin.php
msgid "Move image left"
msgstr "Déplacer l'image vers la gauche"

#: includes/class-oli-vig-admin.php
msgid "Move image right"
msgstr "Déplacer l'image vers la droite"

#: includes/class-oli-vig-admin.php
msgid "Variation gallery images"
msgstr "Images de galerie de variation"

#: includes/class-oli-vig-admin.php
msgid "The first image of the variation remains the main image."
msgstr "La première image de la variation reste l'image principale."

#: includes/class-oli-vig-admin.php
msgid "No images: the product gallery will be used."
msgstr "Aucune image : la galerie du produit sera utilisée."

#: includes/class-oli-vig-admin.php
msgid "Add images"
msgstr "Ajouter des images"

#: includes/class-oli-vig-settings.php
msgid "Variation galleries"
msgstr "Galeries de variations"

#: includes/class-oli-vig-settings.php
msgid "Configure how variation galleries are displayed on product pages."
msgstr "Configurez l'affichage des galeries de variations sur les pages produit."

#: includes/class-oli-vig-settings.php
msgid "Thumbnail position"
msgstr "Position des miniatures"

#: includes/class-oli-vig-settings.php
msgid "Bottom"
msgstr "En bas"

#: includes/class-oli-vig-settings.php
msgid "Left"
msgstr "À gauche"

#: includes/class-oli-vig-settings.php
msgid "Right"
msgstr "À droite"

#: includes/class-oli-vig-settings.php
msgid "Thumbnail mode"
msgstr "Mode des miniatures"

#: includes/class-oli-vig-settings.php
msgid "Grid"
msgstr "Grille"

#: includes/class-oli-vig-settings.php
msgid "Carousel"
msgstr "Carrousel"

#: includes/class-oli-vig-settings.php
msgid "Thumbnail columns"
msgstr "Colonnes de miniatures"

#: includes/class-oli-vig-settings.php
msgid "Number of thumbnail columns (1-8)."
msgstr "Nombre de colonnes de miniatures (1-8)."

#: includes/class-oli-vig-settings.php
msgid "Enable zoom"
msgstr "Activer le zoom"

#: includes/class-oli-vig-settings.php
msgid "Enable image zoom on hover."
msgstr "Activer le zoom au survol."

#: includes/class-oli-vig-settings.php
msgid "Enable lightbox"
msgstr "Activer la lightbox"

#: includes/class-oli-vig-settings.php
msgid "Enable lightbox when clicking images."
msgstr "Activer la lightbox lors du clic sur les images."

#: includes/class-oli-vig-settings.php
msgid "Advanced"
msgstr "Avancé"

#: includes/class-oli-vig-settings.php
msgid "Reset gallery on clear"
msgstr "Réinitialiser la galerie lors de l'effacement"

#: includes/class-oli-vig-settings.php
msgid "Reset to the product gallery when the variation is cleared."
msgstr "Revenir à la galerie du produit lorsque la variation est effacée."

#: includes/class-oli-vig-settings.php
msgid "Preload images"
msgstr "Précharger les images"

#: includes/class-oli-vig-settings.php
msgid "Preload variation images for faster switching. This can increase the page weight on products with many variation images."
msgstr "Précharger les images de variation pour un changement plus rapide. Cela peut augmenter le poids de la page si de nombreuses variations ont de grandes galeries."

#: includes/class-oli-vig-settings.php
msgid "Transition effect"
msgstr "Effet de transition"

#: includes/class-oli-vig-settings.php
msgid "None"
msgstr "Aucune"

#: includes/class-oli-vig-settings.php
msgid "Fade"
msgstr "Fondu"

#: includes/class-oli-vig-settings.php
msgid "Slide"
msgstr "Glissement"

#: includes/class-oli-vig-settings.php
msgid "Animation when switching images in carousel mode. Honors prefers-reduced-motion."
msgstr "Animation lors du changement d'image en mode carrousel. Respecte prefers-reduced-motion."

#: includes/class-oli-vig-settings.php
msgid "Gallery width"
msgstr "Largeur de la galerie"

#: includes/class-oli-vig-settings.php
msgid "Leave 100% to follow the theme."
msgstr "Laissez 100 % pour suivre le thème."

#: includes/class-oli-vig-settings.php
msgid "Variation Gallery Settings"
msgstr "Paramètres de galerie de variation"

#: includes/class-oli-vig-settings.php
msgid "Variation Gallery"
msgstr "Galerie de variation"

#: includes/class-oli-vig-settings.php
msgid "Settings"
msgstr "Réglages"


{
    "name": "olivierbigras/oli-variation-images-gallery",
    "description": "Add unlimited gallery images per product variation with thumbnail gallery, zoom, and lightbox support",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Olivier Bigras",
            "email": "contact@olivierbigras.com",
            "homepage": "https://olivierbigras.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "scripts": {
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "php tests/test-importer.php && php tests/test-upgrade-migrate.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
